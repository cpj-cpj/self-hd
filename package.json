{
  "name": "self-hd",
  "version": "1.0.0",
  "description": "SIT223 7.3HD Jenkins DevOps pipeline demo service.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node scripts/build.js",
    "test": "npx jest",
    "lint": "eslint src test scripts",
    "quality": "npm run lint && npm test",
    "security:audit": "npm audit --audit-level=high"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputName": "junit.xml"
        }
      ]
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "text",
      "lcov",
      "json",
      "clover"
    ]
  },
  "keywords": [
    "jenkins",
    "docker",
    "devops",
    "sit223"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
